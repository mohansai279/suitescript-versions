# Copy to .env for local use (export these before `npm start`).
PORT=3000
APP_URL=http://localhost:3000
# Required in production. Encrypts stored NetSuite credentials. Generate: openssl rand -hex 32
APP_SECRET=
# Where the SQLite database lives
DATA_DIR=./data
TRIAL_DAYS=14

# Stripe (billing UI stays hidden until the first two are set)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
