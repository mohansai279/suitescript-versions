{
  "manifest_version": 3,
  "name": "SuiteScript Version Guard",
  "version": "1.1.1",
  "description": "Version history for SuiteScript files in NetSuite: a Version dropdown on the file page, a diff of every change, and alerts when a script is edited.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SuiteScript Version Guard"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://*.app.netsuite.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.app.netsuite.com/*"],
      "js": ["vendor/diff.js", "ui.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.app.netsuite.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "111"
}
